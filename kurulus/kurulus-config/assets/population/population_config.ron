// Population & Worker Slot Configuration
// =========================================
// Controls population growth rates, building slot capacities, and
// per-building-type worker limits.

GrowthConfig(
    base_growth_rate: 0.02,           // Base growth: 2% per update tick
    max_growth_rate: 0.08,            // Cap: 8% per tick when all needs met
    decline_rate: 0.05,               // Decline: 5% per tick when needs are critical
    needs_met_threshold: 0.7,          // 70%+ need satisfaction → growth
    housing_required_per_citizen: 1.0, // Each citizen requires 1 housing unit
    growth_boost_well: 1.5,           // 50% bonus with well in district
    growth_boost_mosque: 2.0,         // 100% bonus with mosque in district
    growth_boost_bath: 1.5,           // 50% bonus with bathhouse in district
    elite_housing_threshold: 5,       // Population 5+ triggers elite housing
    urban_housing_threshold: 10,      // Population 10+ triggers urban housing
)

WorkerSlotConfig(
    slot_definitions: {
        // === ECONOMY BUILDINGS ===
        Pasture: (
            max_workers: 4,
            role: Gatherer,
            base_production_rate: 10.0,
        ),
        MiningCamp: (
            max_workers: 3,
            role: Gatherer,
            base_production_rate: 5.0,
        ),
        LumberCamp: (
            max_workers: 4,
            role: Gatherer,
            base_production_rate: 8.0,
        ),

        // === MILITARY BUILDINGS ===
